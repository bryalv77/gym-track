default_platform(:ios)

platform :ios do
  desc "Build the prebuilt ios/ project and upload to TestFlight"
  lane :beta do
    key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
    build = latest_testflight_build_number(app_identifier: "com.devalv.gymtrack", api_key: key) + 1

    # Automatic signing: Xcode creates/fetches the distribution cert + profile via the API key.
    build_app(
      workspace: "ios/GymTrack.xcworkspace",
      scheme: "GymTrack",
      export_method: "app-store",
      output_directory: "build",
      output_name: "GymTrack.ipa",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{ENV.fetch('ASC_KEY_PATH')} " \
              "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} -authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')} " \
              "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')} CURRENT_PROJECT_VERSION=#{build}"
    )
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  desc "Upload an already-built ipa (IPA env var) to TestFlight"
  lane :upload do
    key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
    upload_to_testflight(ipa: ENV.fetch("IPA"), api_key: key, skip_waiting_for_build_processing: true)
  end
end
