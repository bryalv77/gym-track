{
  "name": "gym-track",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@neondatabase/serverless": "^1.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@reduxjs/toolkit": "^2.12.0",
    "expo": "~57.0.33",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-localization": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.28",
    "hono": "^4.13.19",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "husky": "^9.1.7",
    "typescript": "~6.0.3",
    "wrangler": "^4.163.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc -p api/tsconfig.json --noEmit",
    "api:dev": "wrangler dev",
    "api:deploy": "wrangler deploy",
    "db:migrate": "node api/db/migrate.mjs",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "test": "node --test api/test/*.test.mjs",
    "deploy:web": "expo export --platform web --clear && wrangler deploy -c wrangler.web.toml",
    "deploy:mobile": "expo export --platform ios --platform android --clear && pnpm dlx eas-cli@latest update --skip-bundler --branch production --message \"$(git log -1 --pretty=%s)\" --environment production --non-interactive",
    "prepare": "husky",
    "release:ios": "scripts/release-ios.sh"
  },
  "private": true,
  "packageManager": "pnpm@8.15.6"
}
