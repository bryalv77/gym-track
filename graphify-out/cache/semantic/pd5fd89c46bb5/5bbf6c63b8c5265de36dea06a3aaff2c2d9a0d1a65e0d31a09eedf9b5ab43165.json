{"nodes": [{"id": "readme_gymtrack", "label": "GymTrack", "file_type": "document", "source_file": "README.md", "source_location": "L1-L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_multi_gym_multi_role_architecture", "label": "Multi-Gym Multi-Role Architecture", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single codebase and a single Firebase project serve many gyms and three role tiers; tenancy is modelled as a gymId field on users rather than separate apps or databases, so one deployment can onboard new gyms without code changes."}, {"id": "readme_admin_role", "label": "Admin Role", "file_type": "concept", "source_file": "README.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_coach_role", "label": "Coach Role", "file_type": "concept", "source_file": "README.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_member_role", "label": "Member Role", "file_type": "concept", "source_file": "README.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_exercise_library", "label": "Exercise Library", "file_type": "concept", "source_file": "README.md", "source_location": "L13-L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A curated, gym-wide library keeps demo media and metric definitions in one place so coaches assign rather than re-author exercises, and members always see the same reference media."}, {"id": "readme_type_driven_metrics", "label": "Type-Driven Exercise Metrics", "file_type": "concept", "source_file": "README.md", "source_location": "L13-L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An exercise type (strength, cardio, other) selects which metric fields apply, with 'other' allowing admin-defined custom fields \u2014 trading rigid schema for per-exercise flexibility."}, {"id": "readme_prescription", "label": "Personalized Prescription (Sets/Reps/Weight, Minutes/Speed)", "file_type": "concept", "source_file": "README.md", "source_location": "L10, L58", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_assignment_workflow", "label": "Day-and-Member Assignment Workflow (Coach Plan Screen)", "file_type": "concept", "source_file": "README.md", "source_location": "L90", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_coach_routines", "label": "Private Coach Routines", "file_type": "concept", "source_file": "README.md", "source_location": "L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routines are namespaced under routines/{coachId} and kept private to the creating coach, so a coach can reuse a template without exposing it to peers in the same gym."}, {"id": "readme_completion_tracking", "label": "Completion Tracking with Timestamps", "file_type": "concept", "source_file": "README.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_streak_dashboard", "label": "Streak, Weekly Volume and 30-Day Dashboard", "file_type": "concept", "source_file": "README.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_body_measurements", "label": "Weight and Body Measurement Tracking (Progress)", "file_type": "concept", "source_file": "README.md", "source_location": "L11, L60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_gym_codes", "label": "Gym Coach Signup Codes", "file_type": "concept", "source_file": "README.md", "source_location": "L53, L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-service coach signup is gated by a per-gym code stored in gymCodes/{gymId} and admin-read-only, letting coaches join the right gym without an admin manually provisioning each account."}, {"id": "readme_roles_bootstrap", "label": "Roles Bootstrap (First Admin via Console)", "file_type": "concept", "source_file": "README.md", "source_location": "L71-L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no privileged signup path; the first admin is seeded by editing users/{uid}.role in the Firebase console, and all later role changes flow through the admin Users tab."}, {"id": "readme_realtime_database_model", "label": "Realtime Database Data Model", "file_type": "concept", "source_file": "README.md", "source_location": "L49-L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Denormalized paths (gyms, gymCodes, users, exercises, routines, assignments, completions, measurements) key assignments by date and completions by uid/date so a member's day is a single read and RTDB listeners can subscribe narrowly."}, {"id": "readme_rtdb_live_sync", "label": "Live Sync via Realtime Database Listeners", "file_type": "concept", "source_file": "README.md", "source_location": "L91-L92", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RTDB listeners replace polling so a coach's assignment appears on the member's Today screen instantly and everything stays consistent across devices in the same gym."}, {"id": "readme_redux_store_slices", "label": "Redux Toolkit Store and Slices", "file_type": "code", "source_file": "README.md", "source_location": "L24, L42-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ios_ui_kit", "label": "Custom iOS-Style UI Component Kit (src/ui)", 