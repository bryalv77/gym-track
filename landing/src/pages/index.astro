---
const roles = [
  {
    name: 'Members',
    text: 'See today\'s exercises, check them off, and watch your streak grow. Log weight, body measurements and progress selfies.',
  },
  {
    name: 'Coaches',
    text: 'Assign exercises and routines per day with a personalized prescription: sets, reps, weight, minutes, speed.',
  },
  {
    name: 'Admins',
    text: 'Manage gyms, users, roles and the shared exercise library from one place.',
  },
];

const features = [
  ['Daily workout plan', 'Your coach\'s plan for the day, front and center. Tick exercises off as you go.'],
  ['Streaks & dashboard', 'Consistency made visible, so skipping a day feels like something.'],
  ['Body progress', 'Weight, measurements and progress selfies in one timeline.'],
  ['Multi-gym', 'One app for many gyms, each with its own coaches and members.'],
  ['iOS, Android & Web', 'One codebase, native feel everywhere, light and dark mode.'],
  ['Live sync', 'Coach edits show up on the member\'s phone without a refresh.'],
];

const title = 'Fitlance: your gym, your coach, your plan';
const description =
  'Fitlance connects members, coaches and gym admins. Daily workouts, streaks, body progress and a shared exercise library on iOS, Android and the web.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EE7533" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.png" />
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/"><img src="/icon.png" alt="" width="32" height="32" />Fitlance</a>
      <nav>
        <a href="#roles">Who it's for</a>
        <a href="#features">Features</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Train with a plan.<br />Not a guess.</h1>
        <p class="lead">
          Fitlance puts your coach's plan in your pocket. Check off today's workout, keep your streak
          and track your progress, all in one app built for gyms.
        </p>
        <div class="cta">
          <a class="btn primary" href="#get">Get the app</a>
          <a class="btn" href="#features">See what's inside</a>
        </div>
      </section>

      <section id="roles">
        <h2>Built for everyone in the gym</h2>
        <div class="grid three">
          {roles.map((r) => (
            <article class="card">
              <h3>{r.name}</h3>
              <p>{r.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="features">
        <h2>Everything you need, nothing you don't</h2>
        <ul class="grid three plain">
          {features.map(([t, d]) => (
            <li>
              <h3>{t}</h3>
              <p>{d}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="get" class="final">
        <h2>Ready to start?</h2>
        <p>Ask your gym for an invite, or open the web app now.</p>
        <a class="btn primary" href="https://gym-track-web.bryalv77.workers.dev">Open Fitlance</a>
      </section>
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Fitlance</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --accent: #ee7533;
    --accent-ink: #b8501a;
    --bg: #fffaf6;
    --ink: #1c1410;
    --muted: #6b5d54;
    --line: #eadfd6;
    --card: #ffffff;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --accent-ink: #ff9a63;
      --bg: #17110d;
      --ink: #f7efe8;
      --muted: #b3a498;
      --line: #33271f;
      --card: #211812;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 17px/1.55 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  a { color: inherit; }
  .nav, main, footer { width: min(1080px, 100% - 32px); margin-inline: auto; }
  .nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 0;
  }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; text-decoration: none; }
  .brand img { border-radius: 8px; }
  .nav nav { display: flex; gap: 20px; }
  .nav nav a { text-decoration: none; color: var(--muted); }
  .nav nav a:hover { color: var(--ink); }
  section { padding: 64px 0; }
  .hero { padding: 88px 0 72px; max-width: 760px; }
  h1 { font-size: clamp(2.5rem, 7vw, 4.5rem); line-height: 1.04; letter-spacing: -0.03em; margin: 0 0 24px; }
  h1 { text-wrap: balance; }
  h2 { font-size: clamp(1.6rem, 4vw, 2.25rem); letter-spacing: -0.02em; margin: 0 0 32px; }
  h3 { margin: 0 0 6px; font-size: 1.1rem; }
  p { margin: 0; color: var(--muted); }
  .lead { font-size: 1.2rem; max-width: 56ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .btn {
    display: inline-block; padding: 12px 22px; border-radius: 12px;
    border: 1px solid var(--line); text-decoration: none; font-weight: 600;
    background: var(--card);
  }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn.primary:hover { filter: brightness(0.94); }
  .btn:focus-visible, a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .grid { display: grid; gap: 20px; }
  .grid.three { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .plain { list-style: none; padding: 0; margin: 0; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  .card h3 { color: var(--accent-ink); }
  .plain li { border-top: 2px solid var(--accent); padding-top: 14px; }
  .final { text-align: center; border-top: 1px solid var(--line); }
  .final p { margin-bottom: 24px; }
  footer { padding: 32px 0 48px; color: var(--muted); font-size: 0.9rem; border-top: 1px solid var(--line); }
</style>
